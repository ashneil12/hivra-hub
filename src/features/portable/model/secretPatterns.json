{
  "comment": "What an export never carries. Read by the webview (secrets.ts) and by Rust (src-tauri/src/portable.rs, include_str!), so both scrub with one list. Every pattern must compile in JavaScript and in Rust's regex crate (no lookaround, no backreferences; case-insensitivity goes in flags). group: replace only capture group 1. mixed: the replaced text must hold a letter and a digit. secretKeys: a JSON value under a key with one of these names is removed whatever it looks like.",
  "marker": "[secret removed]",
  "patterns": [
    { "name": "Anthropic key", "regex": "sk-ant-[A-Za-z0-9_-]{20,}" },
    { "name": "API key (sk-)", "regex": "\\bsk-(?:proj-|svcacct-|or-v1-|live-)?[A-Za-z0-9_-]{32,}" },
    { "name": "GitHub token", "regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}" },
    { "name": "GitHub token", "regex": "\\bgithub_pat_[A-Za-z0-9_]{40,}" },
    { "name": "GitLab token", "regex": "\\bgl(?:pat|dt|rtr?)-[A-Za-z0-9_-]{20,}(?:\\.[A-Za-z0-9_-]+)*" },
    { "name": "PyPI token", "regex": "\\bpypi-AgE[A-Za-z0-9_-]{40,}" },
    { "name": "SendGrid key", "regex": "\\bSG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}" },
    { "name": "Slack token", "regex": "\\bxox[abposr]-[A-Za-z0-9-]{10,}" },
    { "name": "Slack app token", "regex": "\\bxapp-[A-Za-z0-9-]{20,}" },
    { "name": "Stripe webhook secret", "regex": "\\bwhsec_[A-Za-z0-9_-]{20,}" },
    { "name": "AWS access key", "regex": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "name": "Google API key", "regex": "\\bAIza[0-9A-Za-z_-]{35}" },
    { "name": "Stripe key", "regex": "\\b(?:sk|rk)_(?:live|test)_[0-9A-Za-z]{16,}" },
    { "name": "Private key", "regex": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----[\\s\\S]*?-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----" },
    { "name": "JSON web token", "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}" },
    { "name": "Supabase token", "regex": "\\bsbp_[A-Za-z0-9]{30,}" },
    { "name": "xAI key", "regex": "\\bxai-[A-Za-z0-9]{40,}" },
    { "name": "Resend key", "regex": "\\bre_[A-Za-z0-9]{8,}_[A-Za-z0-9]{16,}" },
    { "name": "npm token", "regex": "\\bnpm_[A-Za-z0-9]{36}" },
    { "name": "Hugging Face token", "regex": "\\bhf_[A-Za-z0-9]{30,}" },
    { "name": "Bearer token", "regex": "\\b[Bb]earer\\s+([A-Za-z0-9._~+/=-]{20,})", "group": 1, "mixed": true },
    { "name": "Password in a link", "regex": "://[^/\\s:@\"']+:([^/\\s:@\"']{6,})@", "group": 1 },
    { "name": "Password variable", "regex": "\\b(?:PGPASSWORD|MYSQL_PWD|REDISCLI_AUTH|SSHPASS)\\s*=\\s*(?:\\\\?[\"'])?([^\\s\"'\\\\$<{*\\[-][^\\s\"'\\\\]{3,})", "group": 1 },
    { "name": "mysql password", "regex": "\\bmysql(?:dump|admin|import|show|check|slap|sh)?\\b[^\\n\";|&]*?\\s(?:-p|--password=)(?:\\\\?[\"'])?([^\\s\"'\\\\$<{*\\[-][^\\s\"'\\\\]{3,})", "group": 1 },
    { "name": "sshpass password", "regex": "\\bsshpass\\s+-p\\s*(?:\\\\?[\"'])?([^\\s\"'\\\\$<{*\\[-][^\\s\"'\\\\]{2,})", "group": 1 },
    { "name": "curl password", "regex": "\\bcurl\\b[^\\n\";|&]*?\\s(?:-u\\s*|--user[\\s=]+)(?:\\\\?[\"'])?[^\\s:\"'\\\\]+:([^\\s\"'\\\\$<{*\\[-][^\\s\"'\\\\]{3,})", "group": 1 },
    { "name": "redis-cli password", "regex": "\\bredis-cli\\b[^\\n\";|&]*?\\s(?:-a|--pass)\\s+(?:\\\\?[\"'])?([^\\s\"'\\\\$<{*\\[-][^\\s\"'\\\\]{3,})", "group": 1 },
    {
      "name": "Assigned secret",
      "regex": "(?:api[_-]?key|apikey|client[_-]?secret|secret|token|password|passwd|access[_-]?key)[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9._~+/=-]{16,})",
      "flags": "i",
      "group": 1,
      "mixed": true
    }
  ],
  "secretKeys": "^(?:api[_-]?key|apikey|client[_-]?secret|secret|secret[_-]?key|token|access[_-]?token|refresh[_-]?token|id[_-]?token|auth[_-]?token|bearer|password|passwd|private[_-]?key|access[_-]?key)$"
}
