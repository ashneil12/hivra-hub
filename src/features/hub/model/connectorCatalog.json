      "auth": {
        "methods": ["oauth", "token"],
        "oauth": { "mode": "mcp" },
        "fields": [{ "key": "token", "label": "API key", "secret": true, "placeholder": "napi_…" }],
        "getUrl": "https://console.neon.tech/app/settings/api-keys"
      }
    },
    {
      "id": "cloudflare",
