      "launch": { "kind": "remote", "url": "{mcp_url}", "headers": {} },
      "auth": {
        "methods": ["token"],
        "fields": [{ "key": "mcp_url", "label": "Your Zapier MCP server URL", "secret": true, "placeholder": "https://mcp.zapier.com/api/mcp/…" }],
