{
  "version": 1,
  "googleClient": {
    "redirect": "http://localhost:47821/callback",
    "authorize": "https://accounts.google.com/o/oauth2/v2/auth",
    "token": "https://oauth2.googleapis.com/token",
    "help": "Google's Workspace MCP servers are in Developer Preview. In your own Google Cloud project: join the Workspace Developer Preview Program, enable the API for each server you connect, then make one OAuth client (type Web application, \"Use this client for an AI-powered agent\" ticked) with the redirect URI http://localhost:47821/callback. Paste its client ID and secret once; every Google connector uses them.",
    "getUrl": "https://console.cloud.google.com/auth/clients"
  },
  "connectors": [
    {
      "id": "github",
      "name": "GitHub",
      "category": "Code and deploys",
      "blurb": "Repos, issues, pull requests and Actions.",
      "server": "GitHub's official MCP server (api.githubcopilot.com)",
      "docs": "https://github.com/github/github-mcp-server",
      "launch": { "kind": "remote", "url": "https://api.githubcopilot.com/mcp/", "headers": { "Authorization": "Bearer {token}" } },
      "auth": {
        "methods": ["token"],
        "fields": [{ "key": "token", "label": "Personal access token", "secret": true, "placeholder": "github_pat_…" }],
        "getUrl": "https://github.com/settings/personal-access-tokens/new",
        "help": "A fine-grained token limited to the repos your Monos should touch."
      },
      "test": { "url": "https://api.github.com/user", "headers": { "Authorization": "Bearer {token}", "User-Agent": "MonoCode-Hub" }, "account": "/login" }
    },
    {
      "id": "supabase",
      "name": "Supabase",
      "category": "Code and deploys",
      "blurb": "Projects, tables, migrations and logs.",
      "server": "Supabase's hosted MCP server (mcp.supabase.com)",
      "docs": "https://supabase.com/docs/guides/ai-tools/mcp",
      "launch": { "kind": "remote", "url": "https://mcp.supabase.com/mcp", "headers": { "Authorization": "Bearer {token}" } },
      "auth": {
        "methods": ["oauth", "token"],
        "oauth": { "mode": "mcp" },
        "fields": [{ "key": "token", "label": "Personal access token", "secret": true, "placeholder": "sbp_…" }],
        "getUrl": "https://supabase.com/dashboard/account/tokens"
      }
    },
    {
      "id": "vercel",
      "name": "Vercel",
      "category": "Code and deploys",
      "blurb": "Deployments, projects, domains and build logs.",
      "server": "Vercel's official MCP server (mcp.vercel.com)",
      "docs": "https://vercel.com/docs/mcp/vercel-mcp",
      "launch": { "kind": "remote", "url": "https://mcp.vercel.com", "headers": { "Authorization": "Bearer {token}" } },
      "auth": { "methods": ["oauth"], "oauth": { "mode": "mcp" } }
    },
    {
      "id": "sentry",
      "name": "Sentry",
      "category": "Code and deploys",
      "blurb": "Errors, issues and releases.",
      "server": "Sentry's hosted MCP server (mcp.sentry.dev)",
      "docs": "https://docs.sentry.io/product/sentry-mcp/",
      "launch": { "kind": "remote", "url": "https://mcp.sentry.dev/mcp", "headers": { "Authorization": "Bearer {token}" } },
      "auth": { "methods": ["oauth"], "oauth": { "mode": "mcp" } }
    },
    {
      "id": "neon",
      "name": "Neon",
      "category": "Code and deploys",
      "blurb": "Postgres projects, branches and queries.",
      "server": "Neon's hosted MCP server (mcp.neon.tech)",
