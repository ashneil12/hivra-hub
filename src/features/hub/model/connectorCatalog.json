      "launch": { "kind": "remote", "url": "http://127.0.0.1:3845/mcp", "headers": {} },
      "auth": { "methods": ["none"], "help": "Turn on the Dev Mode MCP server in Figma's desktop app first." }
    },
    {
      "id": "gmail",
      "name": "Gmail",
      "category": "Google",
      "blurb": "Search threads, read mail, write drafts and labels.",
      "server": "Google's official Gmail MCP server (Developer Preview)",
      "docs": "https://developers.google.com/workspace/gmail/api/guides/configure-mcp-server",
      "launch": { "kind": "remote", "url": "https://gmailmcp.googleapis.com/mcp/v1", "headers": { "Authorization": "Bearer {token}" } },
      "auth": {
        "methods": ["oauth"],
        "oauth": { "mode": "google", "scopes": ["https://www.googleapis.com/auth/gmail.readonly", "https://www.googleapis.com/auth/gmail.compose"] }
      }
    },
    {
      "id": "google-calendar",
      "name": "Google Calendar",
      "category": "Google",
      "blurb": "Calendars, events and free/busy.",
      "server": "Google's official Calendar MCP server (Developer Preview)",
      "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers",
