{
  "name": "monocode-desktop",
  "private": true,
  "version": "0.16.17",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stable": "vite --mode stable",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "mockup:build": "node scripts/mockup-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "host:build": "tsc --noEmit -p host/tsconfig.json && node host/build.mjs",
    "host:package": "npm run host:build && node host/package.mjs",
    "host": "node build/host/monocode-host.mjs",
    "pretest:host": "npm run host:build",
    "test:host": "vitest run --config host/vitest.config.ts",
    "check": "npm run check:web && npm run check:scripts && npm run check:rust",
    "check:web": "vitest run && tsc --noEmit",
    "check:guards": "node scripts/test-guard.mjs && node scripts/quarantine.mjs && node scripts/escapes.mjs",
    "check:guards:strict": "node scripts/test-guard.mjs --strict && node scripts/quarantine.mjs --strict && node scripts/escapes.mjs --strict",
    "check:affected": "node scripts/affected-tests.mjs local",
    "check:scripts": "node --disable-warning=ExperimentalWarning --test scripts/*.test.cjs scripts/*.test.mjs scripts/memory-eval/*.test.mjs",
    "memory:eval": "node scripts/memory-eval.mjs",
    "check:rust": "node scripts/check-rust.mjs",
    "set-version": "node scripts/bump-version.mjs",
    "tauri": "tauri",
    "tauri:stable": "tauri dev --no-watch --config src-tauri/tauri.stable.conf.json",
    "setup:linux:deb": "bash scripts/install-linux-deps-debian.sh",
    "setup:linux:fedora": "bash scripts/install-linux-deps-fedora.sh",
    "build:linux": "tauri build --bundles deb,appimage && bash scripts/repack-appimage.sh",
    "build:fedora": "tauri build --bundles rpm",
    "build:windows": "set \"RUSTUP_TOOLCHAIN=stable-x86_64-pc-windows-msvc\" && tauri build --bundles nsis",
    "hub:check": "bash scripts/identity-guard.sh",
    "hub:dev": "node scripts/hub-dev.mjs",
    "hub:seed-dev": "node scripts/hub-seed-dev.mjs",
    "hub:doctor": "node scripts/hub-doctor.mjs",
    "hub:clean": "node scripts/hub-doctor.mjs --clean",
    "hub:trim": "node scripts/hub-trim.mjs",
    "hub:build": "node scripts/disk-guard.mjs hub:build && CARGO_BUILD_BUILD_DIR=\"$HOME/Library/Caches/monocode-hub/cargo-build\" tauri build --config src-tauri/tauri.hub.conf.json --bundles app && node scripts/hub-dictation-helper.mjs",
    "hub:verify": "node scripts/verify-hub-bundle.mjs \"target/release/bundle/macos/MonoCode Hub.app\"",
    "hub:install": "node --disable-warning=ExperimentalWarning scripts/hub-ship.mjs --legacy",
    "hub:check-all": "node scripts/hub-check-all.mjs",
    "hub:launch-check": "node scripts/hub-launch-check.mjs",
    "hub:ship": "node --disable-warning=ExperimentalWarning scripts/hub-ship.mjs",
    "hub:rollback": "node --disable-warning=ExperimentalWarning scripts/hub-rollback.mjs",
    "hub:verify-live": "node --disable-warning=ExperimentalWarning scripts/hub-verify-live.mjs",
    "hub:realconv": "node --disable-warning=ExperimentalWarning scripts/hub-realconv.mjs",
    "hub:realtest": "node --disable-warning=ExperimentalWarning scripts/hub-realtest.mjs",
    "hub:recover": "bash scripts/recover-sessions.sh",
    "native:dev": "node scripts/dev-native.mjs",
    "native:test:dev": "node --test scripts/dev-native.test.mjs scripts/bundle-native-macos.test.mjs scripts/native-dependencies.test.mjs scripts/native-release.test.mjs scripts/package-native.test.mjs",
    "native:build": "node scripts/build-native.mjs",
    "native:test": "cargo test --locked --manifest-path crates/monocode-gpui/Cargo.toml -p monocode-core --profile native-dev && cargo test --locked --manifest-path crates/monocode-gpui/Cargo.toml -p monocode-gpui --profile native-dev -- --test-threads=1",
    "native:check": "npm run native:test:dev && cargo fmt --manifest-path crates/monocode-gpui/Cargo.toml --all --check && cargo clippy --locked --manifest-path crates/monocode-gpui/Cargo.toml -p monocode-core -p monocode-gpui --all-targets --profile native-dev -- -D warnings && npm run native:test"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.5.11",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@lezer/highlight": "^1.2.3",
    "@pierre/diffs": "1.6.4",
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.2",
    "@tauri-apps/api": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "cuelume": "^0.2.2",
    "emojibase-data": "^17.0.0",
    "frimousse": "^0.4.0",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.0",
    "react-material-icon-theme": "^1.2.0",
    "rehype-harden": "^1.1.8",
    "remend": "^1.3.0",
    "shiki": "^3.23.0",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.2.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "26.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.0",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
